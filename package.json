{
  "name": "react-multi-input-rangeslider",
  "version": "3.0.0",
  "description": "Accessible, themeable dual-thumb range slider for React (price ranges and more). Controlled/uncontrolled, tooltips, marks, RTL, dark mode, CSS-variable theming.",
  "main": "dist/index.cjs",
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run check:package",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:consumer": "node scripts/consumer-smoke.mjs",
    "check:package": "publint --strict && attw --pack . --exclude-entrypoints ./style.css ./style/style.css ./style.layer.css && node scripts/check-package.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "docs": "vite build --base ./ --outDir ../site --emptyOutDir"
  },
  "keywords": [
    "react",
    "range-slider",
    "dual-slider",
    "multi-input",
    "input-range",
    "price-range",
    "slider",
    "accessible",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Samishan11/react-simple-price-range-slider.git"
  },
  "author": "Samishan Thapa Chhetri",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Samishan11/react-simple-price-range-slider/issues"
  },
  "homepage": "https://github.com/Samishan11/react-simple-price-range-slider#readme",
  "peerDependencies": {
    "react": ">=16.8.0 <20",
    "react-dom": ">=16.8.0 <20"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^20.19.42",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.27.7",
    "jsdom": "^29.1.1",
    "publint": "^0.3.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "4.3.3",
    "tslib": "^2.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vitest": "^4.1.12"
  },
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./style.layer.css": "./dist/style.layer.css",
    "./style/style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "type": "module"
}
