{
  "name": "react-multi-input-rangeslider",
  "version": "1.0.11",
  "description": "react-multi-input-rangeslider is a highly customizable and easy-to-use React component that allows users to select a range of values within a specified minimum and maximum range. This component is particularly useful for applications that require a user to specify price ranges, filter ranges, or any other numeric range input. It is built with TypeScript and designed to be flexible and easy to integrate into any React application.",
  "main": "dist/index.cjs",
  "scripts": {
    "build": "tsup && cp src/styles.css dist/style.css",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "dev": "vite",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react",
    "range-slider",
    "multi-input",
    "input-range",
    "price-range"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Samishan11/react-simple-price-range-slider.git"
  },
  "author": "Samishan Thapa Chhetri",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Samishan11/react-simple-price-range-slider/issues"
  },
  "homepage": "https://github.com/Samishan11/react-simple-price-range-slider#readme",
  "peerDependencies": {
    "react": ">=16.8.0 <20",
    "react-dom": ">=16.8.0 <20"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tslib": "^2.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vitest": "^4.1.12"
  },
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": "[\"**/*.css\"]",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./style/style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": "[\"dist\"]",
  "type": "module"
}
